# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments & local env secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging & distribution
build/
dist/
*.egg-info/
.eggs/

# Testing & linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# AgentDeck local runtime database & SQLite WAL snapshots (contains device tokens & local paths)
data/
!data/.gitkeep

# AgentDeck runtime logs
logs/
!logs/.gitkeep

# Temporary & backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig

# IDE & OS metadata
.vscode/
.idea/
.cursor/
.windsurf/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk
